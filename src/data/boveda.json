  "subtitles": [
    {
      "from": 0.0,
      "to": 1.92,
      "text": "Le diste plata a un constructor…"
    },
    {
      "from": 1.95,
      "to": 3.62,
      "text": "y ahora él tiene tremenda Hilux."
    },
    {
      "from": 4.85,
      "to": 7.1,
      "text": "Y tú, tienes un lote con maleza."
    },
    {
      "from": 7.58,
      "to": 9.3,
      "text": "Este es Don Excusas."
    },
    {
      "from": 9.42,
      "to": 12.2,
      "text": "Le recogió plata a 200 personas para un edificio."
    },
    {
      "from": 12.66,
      "to": 14.6,
      "text": "Primer año: «es que llovió»."
    },
    {
      "from": 14.72,
      "to": 17.0,
      "text": "Segundo año: «es que la licencia»."
    },
    {
      "from": 17.26,
      "to": 19.4,
      "text": "Tercer año: «es que mi primo»."
    },
    {
      "from": 19.64,
      "to": 22.0,
      "text": "Y de evidencia te manda… un render."
    },
    {
      "from": 25.18,
      "to": 29.0,
      "text": "En Key Lab construimos tu plataforma de inversión con trazabilidad:"
    },
    {
      "from": 29.22,
      "to": 31.6,
      "text": "cada peso tiene GPS,"
    },
    {
      "from": 31.96,
      "to": 34.2,
      "text": "y todos ven en qué se gastó."
    },
    {
      "from": 34.6,
      "to": 37.1,
      "text": "La plata queda en una bóveda y se libera por hitos."
    },
    {
      "from": 37.3,
      "to": 38.95,
      "text": "Si cumple el hito, cobra."
    },
    {
      "from": 39.06,
      "to": 42.8,
      "text": "Si se atrasa, los inversionistas votan y la congelan hasta que termine."
    },
    {
      "from": 43.22,
      "to": 46.05,
      "text": "¿Y si intenta salir corriendo con la plata?"
    },
    {
      "from": 46.12,
      "to": 46.9,
      "text": "Pues no."
    },
    {
      "from": 47.14,
      "to": 50.9,
      "text": "Seguridad para el inversionista, credibilidad para el constructor."
    }
  ],
