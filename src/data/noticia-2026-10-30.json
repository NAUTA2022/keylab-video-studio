    { "from": 0.0, "to": 0.99, "text": "Noticia del día:" },
    { "from": 1.37, "to": 6.04, "text": "un proyecto inmobiliario argentino ya tiene dueño para casi un tercio de sus fragmentos digitales," },
    { "from": 6.36, "to": 7.33, "text": "en menos de un año." },
    { "from": 7.89, "to": 10.6, "text": "Mientras otros siguen esperando que el cuñado se decida." },
    { "from": 11.21, "to": 15.42, "text": "Según iProUP, Lena Buró, de Grupo Transatlántica y Fundar," },
    { "from": 15.85, "to": 19.31, "text": "ya tiene asignado el 32 % de sus fragmentos." },
    { "from": 19.81, "to": 22.16, "text": "Cuatro de cada diez curiosos terminan quedándose," },
    { "from": 22.46, "to": 26.58, "text": "y cada mes la plataforma crece cerca de un 20 % en usuarios." },
    { "from": 28.37, "to": 30.89, "text": "Si se puede con eso, se puede con tu edificio." },
    { "from": 31.21, "to": 33.9, "text": "En Key Lab construimos tu tokenizadora con tu marca." },
