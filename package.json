{
  "name": "keylab-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "Estudio de video de Key Lab: Remotion + efectos de React Bits atados al cuadro",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render KeyLabReel out/reel.mp4 --concurrency=1",
    "render:wide": "remotion render KeyLabWide out/wide.mp4 --concurrency=1",
    "still": "remotion still KeyLabReel out/still.png --frame=60",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@react-three/fiber": "9.1.2",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/lottie": "^4.0.534",
    "@remotion/three": "4.0.534",
    "@remotion/transitions": "4.0.534",
    "@remotion/zod-types": "4.0.534",
    "comicaljs": "0.4.2",
    "lottie-web": "^5.13.0",
    "ogl": "1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-icons": "5.4.0",
    "remotion": "4.0.534",
    "three": "0.170.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.170.0",
    "typescript": "^7.0.2"
  }
}
